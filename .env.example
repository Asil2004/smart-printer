# Smart Web-Printchi — Muhit o'zgaruvchilari
# Bu faylni nusxalab .env nomi bilan saqlang va qiymatlarni to'ldiring

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SECRET_KEY=smart-printchi-secret-2026

# ── Gemini AI API ─────────────────────────────────────────
# https://aistudio.google.com/app/apikey sahifasidan oling
GEMINI_API_KEY=AIzaSy_SIZNING_KALITINGIZ_BU_YERGA

# ── Printer (CUPS) ────────────────────────────────────────
# CUPS da ro'yxatdan o'tgan printer nomi (lpstat -p bilan ko'ring)
PRINTER_NAME=XP-58
DEFAULT_MEDIA=58x297mm
PRINT_MODE=cups

# ── ESC/POS (to'g'ridan-to'g'ri USB, ixtiyoriy) ──────────
ESCPOS_VENDOR_ID=0x0483
ESCPOS_PRODUCT_ID=0x070b
