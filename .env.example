# Smart Web-Printchi — Muhit o'zgaruvchilari
# Bu faylni nusxalab .env nomi bilan saqlang va qiymatlarni to'ldiring

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SECRET_KEY=smart-printchi-secret-2026

# ── Printer (CUPS) ────────────────────────────────────────
# CUPS da ro'yxatdan o'tgan printer nomi (lpstat -p bilan ko'ring)
PRINTER_NAME=XP-58
DEFAULT_MEDIA=58x297mm
PRINT_MODE=cups

# ── ESC/POS (to'g'ridan-to'g'ri USB, ixtiyoriy) ──────────
ESCPOS_VENDOR_ID=0x0483
ESCPOS_PRODUCT_ID=0x070b

# ── To'lov tasdig'i va xavfsizlik ─────────────────────────
# true: printer FAQAT to'lovi tasdiqlangan buyurtmani chop etadi (tavsiya etiladi)
REQUIRE_PAYMENT_VERIFICATION=true
# Admin paroli: shablon yuklash/o'chirish va Admin API uchun (uzun tasodifiy satr qo'ying)
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# Telegram: "To'ladim" bosilganda sizga ✅/❌ tugmali xabar keladi
# Bot: @BotFather → /newbot (BU LOYIHA UCHUN ALOHIDA BOT — boshqa dastur ishlatmasin)
# Chat ID: botga /start yozing → https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Click Merchant (SHOP API) — merchant shartnomasi bo'lsa
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme Merchant — kassa kaliti (Basic auth: Paycom:<KEY>)
PAYME_KEY=

# ── Rahmat Pro / Multicard (avtomatik tasdiqlanadigan to'lov) ──
# Rahmat Pro / Multicard beradi: application_id, secret va kassa (store) ID
MULTICARD_APPLICATION_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
# Sinov uchun: https://dev-mesh.multicard.uz
MULTICARD_BASE_URL=https://mesh.multicard.uz
# Serverning ochiq manzili + /api/payments/multicard/callback
MULTICARD_CALLBACK_URL=https://smart-printer-mo1g.onrender.com/api/payments/multicard/callback
# Fiskal chek (OFD): xizmatning MXIK kodi va o'lchov birligi (package) kodi — tasnif.soliq.uz
MULTICARD_OFD_MXIK=
MULTICARD_OFD_PACKAGE_CODE=
MULTICARD_OFD_NAME=Hujjat chop etish xizmati
MULTICARD_OFD_VAT=0
MULTICARD_OFD_TIN=
# Ixtiyoriy: callback faqat shu IP dan qabul qilinsin (Multicard hujjatida: 195.158.26.90)
MULTICARD_CALLBACK_IPS=

# Bitta buyurtmada eng ko'p nusxa (server, Pi agent va sayt bir xil qiymatni oladi)
MAX_COPIES=50
