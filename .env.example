# Smart Web-Printchi — Muhit o'zgaruvchilari
# Bu faylni nusxalab .env nomi bilan saqlang va qiymatlarni to'ldiring

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SECRET_KEY=smart-printchi-secret-2026

# ── Printer (CUPS) ────────────────────────────────────────
# CUPS da ro'yxatdan o'tgan printer nomi (lpstat -p bilan ko'ring)
PRINTER_NAME=Canon-LBP3010
DEFAULT_MEDIA=A4
# ── To'lov tasdig'i va xavfsizlik ─────────────────────────
# true: printer FAQAT to'lovi tasdiqlangan buyurtmani chop etadi (tavsiya etiladi)
REQUIRE_PAYMENT_VERIFICATION=true
# Admin paroli: shablon yuklash/o'chirish va Admin API uchun (uzun tasodifiy satr qo'ying)
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# Admin panelga kirish (logo bosilganda). ADMIN_PASSWORD bo'lmasa parol = ADMIN_TOKEN
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Promokodlar: KOD:FOIZ:LIMIT (LIMIT 0 yoki bo'sh = cheksiz), vergul bilan. Masalan: BEPUL:100,TALABA:50:20
PROMO_CODES=

# Telegram: "To'ladim" bosilganda sizga ✅/❌ tugmali xabar keladi
# Bot: @BotFather → /newbot (BU LOYIHA UCHUN ALOHIDA BOT — boshqa dastur ishlatmasin)
# Chat ID: botga /start yozing → https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Click Merchant (SHOP API) — merchant shartnomasi bo'lsa
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Payme Merchant — kassa kaliti (Basic auth: Paycom:<KEY>)
PAYME_KEY=

# Bitta buyurtmada eng ko'p nusxa (server, Pi agent va sayt bir xil qiymatni oladi)
MAX_COPIES=50
